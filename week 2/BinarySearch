class Solution {
    public int search(int[] nums, int target) {
        int low = 0, high = nums.length -1;
        int mid = 0; // 4
        while(low <= high){
            mid = (high - low)/2 + low;
            if(nums[mid] == target){
                return mid;
            }
            else if(nums[mid] < target)
                low = mid + 1;  // 3
            else 
                high = mid - 1;
        }
        return -1;
    }
}