public class Solution extends VersionControl {
    public int firstBadVersion(int n) {
        int low =1, high = n;
        while (low <= high){
            int mid = ((high-low)/2)+low;
            if (isBadVersion(mid)){
                high = mid-1;
            }else{
                low = mid +1 ;
            }
        }
        return low;
    }
}